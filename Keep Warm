name: Keep Supabase warm

# Supabase's free tier auto-pauses a project after ~7 days of inactivity, which
# breaks check-in. This job runs a tiny real DB query every 3 days to reset that
# timer. The URL and anon key below are the same public values already shipped in
# the site's client bundle, so they are safe to keep here.

on:
  schedule:
    - cron: "0 12 */3 * *"   # 12:00 UTC, every 3rd day (max gap ~3 days, well under the 7-day window)
  workflow_dispatch: {}       # lets you run it manually from the Actions tab

jobs:
  ping:
    runs-on: ubuntu-latest
    steps:
      - name: Query attendance (touches Postgres)
        env:
          SUPABASE_URL: https://twlspcqfsfeeikmczyqo.supabase.co
          SUPABASE_ANON_KEY: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InR3bHNwY3Fmc2ZlZWlrbWN6eXFvIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODI0NzIxMjEsImV4cCI6MjA5ODA0ODEyMX0.m7SQ1Z0aXClGmophPA8PatVSAI6hIMe0Y8mDekNU0xw
        run: |
          set -euo pipefail
          # Retry a few times: the very first request after a restart can fail during warmup.
          for attempt in 1 2 3 4 5; do
            code=$(curl -s -o /dev/null -w '%{http_code}' \
              "$SUPABASE_URL/rest/v1/attendance?select=id&limit=1" \
              -H "apikey: $SUPABASE_ANON_KEY" \
              -H "Authorization: Bearer $SUPABASE_ANON_KEY")
            echo "Attempt $attempt: HTTP $code"
            if [ "$code" = "200" ]; then
              echo "Supabase is awake."
              exit 0
            fi
            sleep 15
          done
          echo "Supabase did not return 200 after 5 attempts."
          exit 1
